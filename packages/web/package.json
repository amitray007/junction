{
  "name": "@junction/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "clean:stale-js": "find src -name '*.js' ! -name 'entry-server.js' ! -name 'entry-client.js' -delete",
    "prebuild": "pnpm run clean:stale-js",
    "build": "vite build",
    "gen:icons": "node scripts/gen-brand-icons.mjs",
    "start": "node serve.mjs",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    "./server": "./serve.mjs"
  },
  "dependencies": {
    "@junction/core": "workspace:*",
    "@junction/graphql-client": "workspace:*",
    "@junction/http-client": "workspace:*",
    "@junction/mcp-client": "workspace:*",
    "@junction/openapi-client": "workspace:*",
    "@junction/platform-orchestration": "workspace:*",
    "@junction/source-runtime": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "neverthrow": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.28",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@thesvg/icons": "^3.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "agentation": "^3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.11.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}

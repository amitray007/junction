      "label": "GitHub personal access token",
      "generateUrl": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens",
      "setup": "Create a personal access token from your GitHub account settings as described in [Managing your personal access tokens](https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens). Choose fine-grained permissions or classic scopes that match the API operations you need; GitHub notes that fine-grained PATs include read access to public repositories.",
      "acquisition": "manual"
    },
    "github_app_jwt": {
